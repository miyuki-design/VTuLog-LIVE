{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vtulog-live",
  "compatibility_date": "2026-10-09",
  "main": "./worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}